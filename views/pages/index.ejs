<%- include('../partials/header') %>

  <!-- 히어로 섹션 (소개 및 폼 고정, 뒷배경 Swiper 페이드 슬라이더 전환) -->
  <section class="hero-section">
    <!-- 뒷배경 전용 Swiper 슬라이더 -->
    <div class="hero-bg-swiper swiper">
      <div class="swiper-wrapper">
        <div class="swiper-slide" style="background-image: url('/images/background/hero-bg.png');"></div>
        <div class="swiper-slide" style="background-image: url('/images/background/hero-bg-2.png');"></div>
        <div class="swiper-slide" style="background-image: url('/images/background/hero-bg-3.png');"></div>
      </div>
    </div>

    <div class="hero-bg-overlay"></div>

    <div class="hero-container">
      <div class="hero-grid">
        <!-- 좌측 소개란 (고정 복원) -->
        <div class="hero-text-area">
          <span class="hero-badge">USED CAR GLOBAL EXPORT</span>
          <h1 class="hero-title">수출로 팔면,<br>내 차 값이 <span class="gradient-text">달라집니다</span></h1>
          <p class="hero-subtitle">키로수가 높아서, 연식이 오래돼서 감가 걱정이셨나요?<br>내수 딜러 견적 대비 <strong>최대 300만 원 더 높은</strong> 해외 직수출
            시세를 확인하세요.</p>

          <div class="hero-features-list">
            <div class="h-feature-item"><span class="h-feature-icon"><i class="fa-solid fa-chart-line"></i></span>
              주행거리(키로수)가 많아도 감가 없는 해외 수출 매입</div>
            <div class="h-feature-item"><span class="h-feature-icon"><i class="fa-solid fa-clock"></i></span> 서류 접수부터 구청
              말소 등록까지 당일 100% 원스톱 처리</div>
            <div class="h-feature-item"><span class="h-feature-icon"><i class="fa-solid fa-map-location-dot"></i></span>
              전국 어디나 감가 없는 무료 방문 출장 견적 서비스</div>
          </div>
        </div>

        <!-- 우측 견적 및 무료 상담 신청 폼 -->
        <div class="hero-form-area">
          <div class="form-wrapper">
            <div class="form-header">
              <h3>중고차 수출 무료 상담</h3>
              <p>1분 만에 끝나는 내 차 수출 시세 조회</p>
            </div>
            <form onsubmit="alert('상담 신청이 접수되었습니다. 무드카 중고차 수출 전문 감정사가 신속하게 연락드리겠습니다.'); return false;"
              class="quote-form">
              <div class="form-group">
                <label for="car-model">차량명 <span class="required">*</span></label>
                <input type="text" id="car-model" name="carModel" placeholder="ex) 아반떼 AD, 쏘렌토 R, 스포티지" required>
              </div>

              <div class="form-group">
                <label for="phone">연락처 <span class="required">*</span></label>
                <div class="phone-inputs">
                  <input type="tel" name="phone1" value="010" maxlength="3" required>
                  <span>-</span>
                  <input type="tel" name="phone2" placeholder="0000" maxlength="4" required>
                  <span>-</span>
                  <input type="tel" name="phone3" placeholder="0000" maxlength="4" required>
                </div>
              </div>

              <div class="form-group">
                <label for="mileage">주행거리 (키로수) <span class="required">*</span></label>
                <select id="mileage" name="mileage" required>
                  <option value="" disabled selected>주행거리를 선택하세요</option>
                  <option value="under-10">10만 km 이하</option>
                  <option value="10-20">10만 ~ 20만 km</option>
                  <option value="over-20">20만 km 이상 (수출 강력 추천)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="car-year">차량 연식</label>
                <input type="text" id="car-year" name="carYear" placeholder="ex) 2015년식">
              </div>

              <div class="form-agreement">
                <label class="agreement-label">
                  <input type="checkbox" name="agree" checked required>
                  <span>개인정보 수집 및 이용 동의 (필수)</span>
                </label>
              </div>

              <button type="submit" class="btn-form-submit">
                <span>1분 만에 내 차 견적 확인 Click <i class="fa-solid fa-angle-right"></i></span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 혜택 하이라이트 띠 바 (레퍼런스 스타일 - 이모지를 XEIcon으로 변경) -->
  <section class="highlight-bar-section">
    <div class="highlight-bar-container">
      <div class="hl-item">
        <span class="hl-icon"><i class="fa-solid fa-phone"></i></span>
        <span class="hl-text">상담부터 견적까지<br><strong>무료 상담 / 무료 출장</strong></span>
      </div>
      <div class="hl-item">
        <span class="hl-icon"><i class="fa-solid fa-car"></i></span>
        <span class="hl-text">주행거리가 많아도<br><strong>키로수 높아도 무조건 OK</strong></span>
      </div>
      <div class="hl-item">
        <span class="hl-icon"><i class="fa-solid fa-wrench"></i></span>
        <span class="hl-text">폐차급 노후 차량도<br><strong>연식 오래되고 사고나도 OK</strong></span>
      </div>
      <div class="hl-item">
        <span class="hl-icon"><i class="fa-solid fa-shield-halved"></i></span>
        <span class="hl-text">안전하고 투명한 결제<br><strong>최고가 매입 / 안전한 거래</strong></span>
      </div>
    </div>
  </section>

  <!-- 수출 장점 섹션 -->
  <section id="features" class="features-section">
    <div class="section-container">
      <div class="section-header">
        <h2 class="section-title">내수 판매보다 수출이 유리한 이유</h2>
        <p class="section-subtitle">국내 시장에서는 감가 폭탄을 맞는 노후 중고차도, 해외 바이어 직수출을 통해 가치를 제대로 보상받을 수 있습니다.</p>
      </div>

      <div class="features-grid">
        <!-- 장점 1 -->
        <div class="feature-card">
          <div class="feature-icon">📉</div>
          <h3 class="feature-title">연식 및 주행거리 감가 Zero</h3>
          <p class="feature-desc">주행거리가 20~30만 km 이상이거나 연식이 오래되어 내수 딜러들이 매입을 거부하거나 폐차 수준의 감가를 제안한 차량도 정상 가격으로 매입합니다.</p>
        </div>
        <!-- 장점 2 -->
        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <h3 class="feature-title">해외 직수출 다이렉트 채널</h3>
          <p class="feature-desc">중간 딜러 거품 없이 중동, 남미, 아프리카 등 30여 개국 현지 바이어 네트워크와 다이렉트로 협약되어 있어 압도적인 매입 단가를 제시합니다.</p>
        </div>
        <!-- 장점 3 -->
        <div class="feature-card">
          <div class="feature-icon">📄</div>
          <h3 class="feature-title">깔끔한 당일 신속 말소 처리</h3>
          <p class="feature-desc">차량 인도 즉시 대금을 송금해 드리며, 서류 대행 및 구청 말소 업무를 당일에 신속 완료하여 세금 및 보험 문제를 완전히 정리해 드립니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 무드카만의 프리미엄 차별점 섹션 (비대칭 타이포그래피 스플릿 레이아웃) -->
  <section id="difference" class="difference-section">
    <div class="section-container">
      <div class="diff-split-grid">
        <!-- 좌측: 고정 브랜드 메시지 및 네온 아우라 -->
        <div class="diff-left-area">
          <span class="diff-tag">TRUST & VALUE</span>
          <h2 class="diff-main-title">무드카중고차수출은<br>무엇이 다를까요?</h2>
          <p class="diff-main-subtitle">단순히 차량을 매입하는 것을 넘어, 고객님의 소중한 자산 가치를 극대화하고 투명하고 부당함 없는 안심 거래를 보장하는 무드카만의 3대 신뢰 약속입니다.</p>
          <div class="diff-neon-aura"></div>
        </div>
        
        <!-- 우측: 번호 중심의 미니멀 라인 리스트 -->
        <div class="diff-right-area">
          <div class="diff-list">
            <!-- 차별점 1 -->
            <div class="diff-list-item">
              <span class="diff-item-num">01</span>
              <div class="diff-item-content">
                <div class="diff-item-header">
                  <span class="diff-item-icon"><i class="fa-solid fa-hand-holding-dollar"></i></span>
                  <h3 class="diff-item-title">정확한 최고가 제시</h3>
                </div>
                <p class="diff-item-desc">무드카중고차수출은 해외 각국 지사들을 통해 입찰경쟁 방식으로 최고가만 연결해 드리겠습니다. 타사견적과 비교하시면 느끼실 수 있습니다.</p>
              </div>
            </div>
            
            <!-- 차별점 2 -->
            <div class="diff-list-item">
              <span class="diff-item-num">02</span>
              <div class="diff-item-content">
                <div class="diff-item-header">
                  <span class="diff-item-icon"><i class="fa-regular fa-lightbulb"></i></span>
                  <h3 class="diff-item-title">부당감가 없는 거래</h3>
                </div>
                <p class="diff-item-desc">부당감가는 절대 없는 시스템으로 늘 고객의 입장에서 신뢰할 수 있는 수출 거래 정착을 위해 항상 노력해왔습니다.</p>
              </div>
            </div>
            
            <!-- 차별점 3 -->
            <div class="diff-list-item">
              <span class="diff-item-num">03</span>
              <div class="diff-item-content">
                <div class="diff-item-header">
                  <span class="diff-item-icon"><i class="fa-solid fa-user-shield"></i></span>
                  <h3 class="diff-item-title">합리적인 서비스 제공</h3>
                </div>
                <p class="diff-item-desc">소중한 고객님의 차를 합리적인 가격에 판매하실 수 있게 무드카중고차수출이 도와드리겠습니다. 무드카만의 오랜 노하우와 경험을 바탕으로 합리적인 서비스를 제공하겠습니다.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 수출 시세 비교 리포트 섹션 -->
  <section id="compare" class="compare-section">
    <div class="section-container">
      <div class="section-header">
        <h2 class="section-title">내수 대비 압도적인 수출 매입가 비교</h2>
        <p class="section-subtitle">주행거리가 길고 사고 이력이 있어도, 수출 시장에서는 최고의 가치로 매입합니다.</p>
      </div>

      <div class="compare-rows">
        <!-- 첫 번째 행: 주행거리 비교 (좌 그래프 / 우 설명&이미지) -->
        <div class="compare-row">
          <!-- 좌: 그래프 카드 -->
          <div class="compare-card graph-card">
            <div class="card-inner">
              <div class="compare-badge-wrapper">
                <span class="compare-badge">자동차 주행거리 15만 km 기준</span>
              </div>
              <h3 class="compare-price-title">평균 <span class="highlight-green-under">200만원</span> 이상 UP!</h3>
              <p class="compare-price-subtitle">중고차수출 주행거리는 큰 감가요인이 아닙니다.</p>

              <div class="graph-container">
                <div class="graph-grid-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="graph-bars">
                  <!-- 국내 매입가격 바 -->
                  <div class="bar-wrapper">
                    <div class="bar-label-top">(평균시세)<br>550~600만원</div>
                    <div class="graph-bar-bg">
                      <div class="graph-bar bar-korea" data-height="70"></div>
                    </div>
                    <div class="bar-label-bottom">국내 매입가격</div>
                  </div>
                  <!-- 수출 매입가격 바 -->
                  <div class="bar-wrapper">
                    <div class="bar-label-top highlight-price">800만원</div>
                    <div class="graph-bar-bg">
                      <div class="graph-bar bar-export" data-height="100"></div>
                    </div>
                    <div class="bar-label-bottom highlight-price-bottom">수출 매입가격</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 우: 다크 설명 & 대시보드 이미지 카드 -->
          <div class="compare-card info-card dark-theme">
            <div class="image-overlay-bg" style="background-image: url('/images/background/live-dashboard.png');"></div>
            <div class="card-gradient-overlay"></div>
            <div class="card-content">
              <h3 class="info-title">중고차수출 매입가<br>평균 <span class="highlight-yellow">200만원 이상 UP!</span></h3>
              <p class="info-desc">
                수출 시장에서는 주행거리가 주요 감가 요인이 되지 않습니다. 오히려 차량의 내구성, 엔진 상태, 그리고 해당 모델의 글로벌 수요가 더 중요한 요소로 작용합니다.<br><br>
                <strong>"주행거리 때문에 걱정하지 마세요! 차량 모델과 상태만 좋다면 수출 시장에서는 여전히 높은 가치를 평가받습니다."</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- 두 번째 행: 사고이력 비교 (좌 설명&이미지 / 우 그래프) -->
        <div class="compare-row reverse">
          <!-- 좌: 다크 설명 & 사고 이미지 카드 -->
          <div class="compare-card info-card dark-theme">
            <div class="image-overlay-bg" style="background-image: url('/images/background/car-accident.png');"></div>
            <div class="card-gradient-overlay"></div>
            <div class="card-content">
              <h3 class="info-title">중고차수출 시<br><span class="highlight-yellow">사고이력은 상관없다!</span></h3>
              <p class="info-desc">
                중고차를 수출할 때에는 국내 매입가와는 다른 기준으로 중고차의 가치가 산정됩니다. 사고 이력보다 차량의 사용 가능성과 부품 활용성을 중요하게 보고 있습니다.<br><br>
                <strong>무드카중고차수출</strong>은 수출 시장에서 차량의 가치를 정직하게 평가하여 사고 차량도 수출로 더 높은 가치를 찾아드리겠습니다.
              </p>
            </div>
          </div>

          <!-- 우: 그래프 카드 -->
          <div class="compare-card graph-card">
            <div class="card-inner">
              <div class="compare-badge-wrapper">
                <span class="compare-badge">자동차 사고이력 기준</span>
              </div>
              <h3 class="compare-price-title">웬만해선 <span class="highlight-italic">감가없음!</span></h3>
              <p class="compare-price-subtitle">중고차수출 사고내역은 큰 감가요인이 아닙니다.</p>

              <div class="graph-container">
                <div class="graph-grid-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="graph-bars">
                  <!-- 국내 매입가격 바 -->
                  <div class="bar-wrapper">
                    <div class="bar-label-top">(평균시세)<br>520만원</div>
                    <div class="graph-bar-bg">
                      <div class="graph-bar bar-korea" data-height="65"></div>
                    </div>
                    <div class="bar-label-bottom">국내 매입가격</div>
                  </div>
                  <!-- 수출 매입가격 바 -->
                  <div class="bar-wrapper">
                    <div class="bar-label-top highlight-price">800만원</div>
                    <div class="graph-bar-bg">
                      <div class="graph-bar bar-export" data-height="100"></div>
                    </div>
                    <div class="bar-label-bottom highlight-price-bottom">수출 매입가격</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- 수출 완료 현황 섹션 -->
